#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
python_bin="${PYTHON:-python3}"
if [[ -z "${PYTHON:-}" && -x .venv/bin/python ]]; then
  python_bin=.venv/bin/python
fi
if ! "$python_bin" -c 'import markdown' >/dev/null 2>&1; then
  echo 'Missing web dependency. Run: python3 -m venv .venv && .venv/bin/pip install -r requirements-web.txt' >&2
  echo 'Then run: ./server' >&2
  exit 1
fi
exec "$python_bin" scripts/serve_site.py "$@"
